---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FotoNoticia from '../../components/FotoNoticia.astro';

export async function getStaticPaths() {
  const todas = (await getCollection('noticias', ({ data }) => !data.rascunho)).sort((a, b) => +b.data.data - +a.data.data);
  return todas.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, anterior: todas[i + 1] ?? null, proxima: todas[i - 1] ?? null },
  }));
}

const { entry, anterior, proxima } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const fmt = (x: Date) => x.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' });
const iso = d.data.toISOString().slice(0, 10);
const palavras = (entry.body ?? '').split(/\s+/).filter(Boolean).length;
const minutos = Math.max(1, Math.round(palavras / 200));
const titulo = d.titulo.length > 46 ? d.titulo : `${d.titulo} | Eduardo Rivabem`;
const raiz = Astro.site ? Astro.site.href.replace(/\/$/, '') : '';
const graph = Astro.site ? [{
  '@type': 'BlogPosting', '@id': `${raiz}/noticias/${entry.id}#post`, headline: d.titulo, description: d.resumo,
  datePublished: iso, dateModified: iso, inLanguage: 'pt-BR', mainEntityOfPage: `${raiz}/noticias/${entry.id}`,
  author: { '@id': `${raiz}/#pessoa` }, publisher: { '@id': `${raiz}/#pessoa` },
  ...(d.foto ? { image: `${raiz}/img/noticias/${d.foto}-640.webp` } : {}),
}] : [];
---
<Base title={titulo} description={d.resumo} type="article" published={iso} graph={graph}>
  <article class="np">
    <header class="np-head">
      <div class="wrap np-head__in">
        <a class="np-back" href="/noticias">← Todas as notícias</a>
        <p class="np-meta"><span class="np-tag">{d.tipo}</span><time datetime={iso}>{fmt(d.data)}</time><span>{minutos} min de leitura</span></p>
        <h1>{d.titulo}</h1>
        <p class="np-resumo">{d.resumo}</p>
      </div>
    </header>

    <div class="frame frame--inv np-body-frame">
      <div class="np-body wrap">
        {d.foto && d.fotoW && d.fotoH && (
          <FotoNoticia class="np-foto" foto={d.foto} w={d.fotoW} h={d.fotoH} alt={d.fotoAlt} sizes="(max-width:820px) 92vw, 720px" loading="eager" fetchpriority="high" />
        )}
        <div class="prose"><Content /></div>

        <div class="np-actions">
          <button class="btn" type="button" id="copiar" data-url="">Copiar link</button>
          <span class="np-ok" id="copiado" role="status" aria-live="polite"></span>
        </div>
      </div>
    </div>

    <nav class="wrap np-nav" aria-label="Outras notícias">
      {anterior ? <a class="np-nav__a" href={`/noticias/${anterior.id}`}><small>← Anterior</small><span>{anterior.data.titulo}</span></a> : <span></span>}
      {proxima ? <a class="np-nav__a np-nav__a--r" href={`/noticias/${proxima.id}`}><small>Próxima →</small><span>{proxima.data.titulo}</span></a> : <span></span>}
    </nav>
  </article>
</Base>

<style is:global>
  .np-head{background:var(--cobalt);padding-top:96px;padding-bottom:var(--s-5)}
  .np-head__in{max-width:860px}
  .np-back{display:inline-block;margin-bottom:var(--s-4);font:600 15px/1 var(--font-body);text-decoration:none;opacity:.9}
  .np-back:hover{text-decoration:underline}
  .np-meta{display:flex;flex-wrap:wrap;gap:var(--s-2) var(--s-3);align-items:center;font:600 14px/1 var(--font-body);margin:0 0 var(--s-3)}
  .np-tag{background:var(--lime);color:var(--ink);border-radius:var(--r-pill);padding:5px 12px;font:700 12px/1 var(--font-body);letter-spacing:.05em;text-transform:uppercase}
  .np-head h1{font:900 clamp(2.4rem,7vw,5rem)/.92 var(--font-display);font-stretch:68%;text-transform:uppercase;letter-spacing:-.005em;margin:0 0 var(--s-3);text-wrap:balance}
  .np-resumo{font-size:var(--t-22);line-height:1.35;max-width:52ch;margin:0;opacity:.95}
  .np-body-frame{padding-block:var(--s-6);margin-top:0}
  .np-body{max-width:820px}
  .np-foto{width:100%;max-width:440px;height:auto;border:6px solid var(--cobalt);border-radius:12px;box-shadow:0 6px 0 var(--ink);margin-bottom:var(--s-5)}
  .prose{max-width:66ch;font-size:19px;line-height:1.7;color:var(--ink)}
  .prose>*+*{margin-top:1.1em}
  .prose h2{font:600 clamp(1.6rem,3.4vw,2.2rem)/1.1 var(--font-body);letter-spacing:-.03em;color:var(--cobalt);margin-top:1.8em}
  .prose h3{font:600 1.35rem/1.2 var(--font-body);letter-spacing:-.02em;color:var(--cobalt);margin-top:1.5em}
  .prose a{color:var(--cobalt);text-decoration-thickness:2px;text-underline-offset:3px;font-weight:600}
  .prose a:hover{background:var(--lime)}
  .prose strong{font-weight:700}
  .prose ul,.prose ol{padding-left:1.3em}
  .prose li+li{margin-top:.4em}
  .prose blockquote{margin-left:0;padding:var(--s-3) var(--s-4);border-left:6px solid var(--lime);background:var(--mist);border-radius:0 var(--r-md) var(--r-md) 0;font-style:italic}
  .prose img{max-width:100%;height:auto;border-radius:12px;border:4px solid var(--cobalt)}
  .prose code{background:var(--mist);padding:2px 6px;border-radius:6px;font-size:.9em}
  .prose hr{border:0;border-top:2px solid var(--cobalt);opacity:.2}
  .np-actions{display:flex;flex-wrap:wrap;gap:var(--s-3);align-items:center;margin-top:var(--s-5)}
  .np-ok{font-weight:600;color:var(--cobalt)}
  .np-nav{display:grid;grid-template-columns:1fr 1fr;gap:var(--s-4);padding-block:var(--s-5) var(--s-6)}
  .np-nav__a{display:grid;gap:6px;padding:var(--s-4);border:2px solid var(--ink);border-radius:var(--r-md);background:var(--white);color:var(--ink);box-shadow:var(--shadow-card);text-decoration:none;transition:transform .3s var(--ease-pop),box-shadow .3s var(--ease-pop)}
  .np-nav__a:hover{transform:translate(-3px,-3px);box-shadow:9px 9px 0 var(--ink)}
  .np-nav__a--r{text-align:right}
  .np-nav__a small{font:700 12px/1 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--cobalt)}
  .np-nav__a span{font:600 var(--t-22)/1.15 var(--font-body);letter-spacing:-.02em}
  @media (max-width:820px){.np-head{padding-top:88px}.np-body-frame{padding-block:var(--s-5)}.np-nav{grid-template-columns:1fr}.prose{font-size:17.5px}}
</style>

<script>
  import { initSmooth } from '../../scripts/smooth';
  initSmooth();

  const btn = document.getElementById('copiar') as HTMLButtonElement;
  const msg = document.getElementById('copiado') as HTMLElement;
  btn.addEventListener('click', async () => {
    const url = location.href.split('#')[0];
    try { await navigator.clipboard.writeText(url); msg.textContent = 'Link copiado!'; }
    catch {
      const t = document.createElement('input'); t.value = url; document.body.appendChild(t); t.select();
      try { document.execCommand('copy'); msg.textContent = 'Link copiado!'; } catch { msg.textContent = url; }
      t.remove();
    }
    setTimeout(() => (msg.textContent = ''), 2500);
  });
</script>
