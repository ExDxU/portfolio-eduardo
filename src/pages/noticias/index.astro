---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Pic from '../../components/Pic.astro';
import FotoNoticia from '../../components/FotoNoticia.astro';

const todas = (await getCollection('noticias', ({ data }) => !data.rascunho)).sort((a, b) => +b.data.data - +a.data.data);
const destaque = todas.find((n) => n.data.destaque) ?? todas[0];
const resto = todas.filter((n) => n !== destaque);
const tipos = [...new Set(todas.map((n) => n.data.tipo))];
const fmt = (d: Date) => d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' }).replace('.', '');
const iso = (d: Date) => d.toISOString().slice(0, 10);
---
<Base
  title="Notícias e conquistas | Eduardo Rivabem"
  description="Eventos, conquistas e novidades do Eduardo Rivabem: da faculdade e do Google ao que ele está aprendendo sobre inteligência artificial."
  preload={{ name: 'obj-noticias', sizes: '(max-width:820px) 55vw, 340px' }}
>
  <!-- ABERTURA -->
  <section class="nt-hero">
    <div class="nt-hero__in wrap">
      <div>
        <p class="eyebrow">Notícias</p>
        <h1 class="nt-h1"><span>Notícias</span> <em>e conquistas</em></h1>
        <p class="nt-lead">Eventos, conquistas e novidades: o que eu fiz, aprendi e vivi, contado por mim.</p>
      </div>
      <div class="nt-hero__art" aria-hidden="true">
        <Pic class="nt-paper" name="obj-noticias" sizes="(max-width:820px) 55vw, 340px" fetchpriority="high" />
        <Pic class="nt-spark" name="ico-estrela" sizes="80px" />
      </div>
    </div>
  </section>

  <section class="frame nt-sec">
    <div class="wrap">
      {todas.length === 0 && (
        <div class="nt-empty">
          <h2 class="t2">As primeiras notícias<em>estão a caminho</em></h2>
          <p class="nt-lead">Enquanto isso, você acompanha tudo no Instagram.</p>
          <p><a class="btn btn--big" href="https://www.instagram.com/devEduardo" target="_blank" rel="noopener">Seguir @DevEduardo</a></p>
        </div>
      )}

      {destaque && (
        <article class="nt-feat">
          <a class="nt-feat__a" href={`/noticias/${destaque.id}`}>
            <span class="nt-feat__txt">
              <span class="nt-tag">Mais recente · {destaque.data.tipo}</span>
              <h2>{destaque.data.titulo}</h2>
              <span class="nt-feat__p">{destaque.data.resumo}</span>
              <time datetime={iso(destaque.data.data)}>{fmt(destaque.data.data)}</time>
              <span class="nt-more">Ler a notícia →</span>
            </span>
            {destaque.data.foto && destaque.data.fotoW && destaque.data.fotoH && (
              <FotoNoticia class="nt-feat__img" foto={destaque.data.foto} w={destaque.data.fotoW} h={destaque.data.fotoH} alt={destaque.data.fotoAlt} sizes="(max-width:820px) 92vw, 460px" loading="eager" style={destaque.data.fotoFoco ? `object-position:${destaque.data.fotoFoco}` : undefined} />
            )}
          </a>
        </article>
      )}

      {resto.length > 0 && (
        <>
          <div class="nt-filtro" role="group" aria-label="Filtrar por tipo">
            <button type="button" class="chip is-on" data-tipo="" aria-pressed="true">Todas</button>
            {tipos.map((t) => <button type="button" class="chip" data-tipo={t} aria-pressed="false">{t}</button>)}
          </div>
          <ol class="nt-list" id="ntList">
            {resto.map((n) => (
              <li class="nt-row" data-tipo={n.data.tipo}>
                <a href={`/noticias/${n.id}`}>
                  <time datetime={iso(n.data.data)}>{fmt(n.data.data)}</time>
                  <span class="nt-row__t">{n.data.titulo}<small>{n.data.tipo}</small></span>
                  <span class="nt-row__p">{n.data.resumo}</span>
                </a>
              </li>
            ))}
          </ol>
        </>
      )}
    </div>
  </section>
</Base>

<style is:global>
  .eyebrow{font:600 13px/1 var(--font-body);letter-spacing:.12em;text-transform:uppercase;opacity:.8;margin:0 0 var(--s-3)}
  .btn--big{padding:15px 24px;font-size:16px}
  .nt-sec{padding-block:var(--s-6)}
  .nt-lead{max-width:50ch;font-size:var(--t-22);line-height:1.35}

  .nt-hero{background:var(--cobalt);padding-top:96px;padding-bottom:var(--s-6);overflow:clip}
  .nt-hero__in{display:grid;grid-template-columns:1.3fr .7fr;gap:var(--s-5);align-items:center}
  .nt-h1{font:900 clamp(3.2rem,9.5vw,8.5rem)/.84 var(--font-display);font-stretch:68%;text-transform:uppercase;letter-spacing:-.01em;margin:0 0 var(--s-4)}
  .nt-h1 span,.nt-h1 em{display:block;white-space:nowrap}
  .nt-h1 em{font-style:italic;font-stretch:62%;color:var(--lime)}
  .nt-hero__art{position:relative;justify-self:center;width:min(340px,80%)}
  .nt-paper{width:100%;height:auto;rotate:6deg;animation:nt-in 1.6s var(--ease-spring) .2s backwards,nt-bob 4.2s ease-in-out 1.8s infinite alternate;will-change:transform}
  .nt-spark{position:absolute;left:-10%;top:-6%;width:24%;height:auto;animation:nt-in 1.6s var(--ease-spring) .6s backwards}
  @keyframes nt-in{from{transform:translateY(40px) scale(.3) rotate(-60deg);opacity:0}}
  @keyframes nt-bob{to{transform:translateY(-8px)}}

  /* destaque */
  .nt-empty{text-align:center;padding-block:var(--s-5)}
  .nt-empty .nt-lead{margin:0 auto var(--s-4)}
  .nt-feat{margin-bottom:var(--s-6)}
  .nt-feat__a{display:grid;grid-template-columns:1.1fr .9fr;gap:var(--s-4);align-items:center;padding:var(--s-5);background:var(--lime);color:var(--ink);border:2px solid var(--ink);border-radius:var(--r-lg);box-shadow:var(--shadow-card);text-decoration:none;transition:transform .35s var(--ease-pop),box-shadow .35s var(--ease-pop)}
  .nt-feat__a:hover{transform:translate(-4px,-4px);box-shadow:10px 10px 0 var(--ink)}
  .nt-feat__a:not(:has(.nt-feat__img)){grid-template-columns:1fr}
  .nt-feat__txt{display:grid;gap:var(--s-3);justify-items:start}
  .nt-tag{background:var(--ink);color:var(--lime);border-radius:var(--r-pill);padding:5px 12px;font:700 12px/1 var(--font-body);letter-spacing:.05em;text-transform:uppercase}
  .nt-feat h2{font:900 italic clamp(2rem,5vw,3.6rem)/.92 var(--font-display);font-stretch:62%;text-transform:uppercase;margin:0}
  .nt-feat__p{font-size:var(--t-22);line-height:1.3}
  .nt-feat time{font:700 14px/1 var(--font-body)}
  .nt-more{font:700 15px/1 var(--font-body);text-decoration:underline;text-underline-offset:4px}
  .nt-feat__img{width:100%;aspect-ratio:4/3;object-fit:cover;border:6px solid var(--white);border-radius:12px;rotate:2deg;box-shadow:0 6px 0 var(--ink)}

  /* filtro e lista (data | título | resumo) */
  .nt-filtro{display:flex;flex-wrap:wrap;gap:var(--s-2);margin-bottom:var(--s-4)}
  .chip{padding:10px 18px;border-radius:var(--r-pill);border:2px solid var(--ink);background:var(--white);color:var(--ink);font:600 15px/1 var(--font-body);cursor:pointer;box-shadow:0 3px 0 var(--ink);transition:transform .4s var(--ease-spring),box-shadow .4s var(--ease-spring)}
  .chip:hover{transform:translateY(-2px);box-shadow:0 5px 0 var(--ink)}
  .chip:active{transform:translateY(2px);box-shadow:0 1px 0 var(--ink)}
  .chip.is-on{background:var(--lime)}
  .nt-list{list-style:none;margin:0;padding:0;border-top:1px solid rgba(255,255,255,.22)}
  .nt-row[hidden]{display:none}
  .nt-row a{display:grid;grid-template-columns:130px minmax(0,1fr) minmax(0,1.3fr);gap:var(--s-2) var(--s-4);align-items:baseline;padding:var(--s-4) var(--s-2);border-bottom:1px solid rgba(255,255,255,.22);text-decoration:none;transition:background .25s,padding .3s var(--ease-pop)}
  .nt-row a:hover{background:var(--cobalt-deep);padding-left:var(--s-4)}
  .nt-row time{font:700 15px/1.2 var(--font-body);color:var(--lime)}
  .nt-row__t{font:600 var(--t-22)/1.15 var(--font-body);letter-spacing:-.02em;display:grid;gap:6px;justify-items:start}
  .nt-row__t small{background:var(--white);color:var(--ink);border-radius:var(--r-pill);padding:3px 9px;font:700 11px/1 var(--font-body);letter-spacing:.05em;text-transform:uppercase}
  .nt-row__p{opacity:.88;font-size:15px;line-height:1.45}

  @media (max-width:820px){
    .nt-hero__in{grid-template-columns:1fr}
    .nt-hero__art{order:-1;width:min(180px,50%);justify-self:start;margin-left:var(--s-3)}
    .nt-hero{padding-top:88px}
    .nt-sec{padding-block:var(--s-5)}
    .nt-feat__a{grid-template-columns:1fr;padding:var(--s-4)}
    .nt-row a{grid-template-columns:1fr}
  }
  @media (prefers-reduced-motion:reduce){.nt-paper,.nt-spark{animation:none}}
</style>

<script>
  import { initSmooth } from '../../scripts/smooth';
  initSmooth();

  // Filtro por tipo
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
  const rows = [...document.querySelectorAll<HTMLElement>('.nt-row')];
  chips.forEach((chip) => chip.addEventListener('click', () => {
    const tipo = chip.dataset.tipo ?? '';
    chips.forEach((c) => { const on = c === chip; c.classList.toggle('is-on', on); c.setAttribute('aria-pressed', String(on)); });
    rows.forEach((r) => { r.hidden = !!tipo && r.dataset.tipo !== tipo; });
  }));
</script>
