---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import CapaProjeto from '../components/CapaProjeto.astro';

// Para adicionar um projeto: `npm run novo-projeto -- "Nome"` (cria o .md em src/content/projetos/).
const projetos = (await getCollection('projetos', ({ data }) => !data.rascunho)).sort((a, b) => a.data.ordem - b.data.ordem);
const itens = await Promise.all(projetos.map(async (p) => ({ p, Content: (await render(p)).Content })));
---
<Base
  title="Projetos de software e IA: RAG, painéis e apps | Eduardo Rivabem"
  description="Projetos de Eduardo Rivabem: mini RAG em Python com Gemini, painel que monitora sites pelo Search Console, mapeador de leads e aplicação web em Flask."
  preload={{ name: 'obj-projetos', sizes: '(max-width:820px) 55vw, 340px' }}
>
  <!-- ABERTURA -->
  <section class="pj-hero">
    <div class="pj-hero__in wrap">
      <div>
        <p class="eyebrow">Projetos</p>
        <h1 class="pj-h1"><span>O que eu</span> <em>construí</em></h1>
        <p class="pj-lead">Inteligência artificial, ferramentas que uso no dia a dia e aplicações web. Abra um projeto para ver o que ele faz e como foi feito.</p>
        <p class="pj-cta">
          <a class="btn btn--big" href="#lista">Ver os projetos</a>
          <a class="btn btn--light btn--big" href="https://github.com/ExDxU" target="_blank" rel="noopener">Meu GitHub</a>
        </p>
      </div>
      <div class="pj-hero__art" aria-hidden="true">
        <Pic class="pj-obj" name="obj-projetos" sizes="(max-width:820px) 55vw, 340px" fetchpriority="high" />
        <Pic class="pj-spark" name="ico-estrela" sizes="80px" />
      </div>
    </div>
  </section>

  <!-- LISTA -->
  <section class="frame frame--inv pj-sec" id="lista">
    <div class="wrap">
      <h2 class="t2">Projetos<em>em destaque</em></h2>
      <ul class="pj-grid" id="pjGrid">
        {itens.map(({ p }) => (
          <li class={`pj-card${p.data.destaque ? ' pj-card--big' : ''}`}>
            <a class="pj-link" href={`#${p.id}`} data-proj={p.id} aria-label={`${p.data.titulo}: ver detalhes`}>
              <CapaProjeto d={p.data} sizes={p.data.destaque ? '(max-width:820px) 92vw, 560px' : '(max-width:820px) 92vw, 400px'} />
              <span class="pj-body">
                {p.data.contexto && <span class="pj-ctx">{p.data.contexto}</span>}
                <span class="pj-t">{p.data.titulo}</span>
                <span class="pj-p">{p.data.resumo}</span>
                <span class="pj-stack">{p.data.stack.slice(0, 4).map((s) => <span>{s}</span>)}</span>
                <span class="pj-go">Ver detalhes <span aria-hidden="true">→</span></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FECHO -->
  <section class="frame pj-sec pj-end">
    <div class="wrap">
      <h2 class="t2">Quer ver<em>o código?</em></h2>
      <p class="pj-lead">Os projetos abertos estão no meu GitHub. Para conversar sobre uma vaga ou um projeto, me escreva.</p>
      <p class="pj-cta pj-cta--c">
        <a class="btn btn--big" href="https://github.com/ExDxU" target="_blank" rel="noopener">Ver meu GitHub</a>
        <a class="btn btn--light btn--big" href="https://www.linkedin.com/in/eduardo-rivabem-2164a53b5/" target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn btn--light btn--big" href="mailto:edurivaserrano@gmail.com">E-mail</a>
      </p>
    </div>
  </section>

  <!-- JANELAS: uma por projeto. O texto já está no HTML da página; a janela só mostra. -->
  {itens.map(({ p, Content }) => (
    <dialog class="pj-modal" id={p.id} aria-labelledby={`t-${p.id}`} data-lenis-prevent>
      <div class="pj-modal__in">
        <button class="pj-modal__x" type="button" data-fechar aria-label="Fechar">✕</button>
        <div class="pj-modal__scroll" data-lenis-prevent>
          <CapaProjeto d={p.data} sizes="(max-width:820px) 94vw, 760px" />
          <div class="pj-modal__txt">
            <p class="pj-modal__meta">
              <span class="pj-tag">{p.data.tipo}</span>
              {p.data.contexto && <span>{p.data.contexto}</span>}
              {p.data.ano && <span>{p.data.ano}</span>}
            </p>
            <h2 class="pj-modal__t" id={`t-${p.id}`}>{p.data.titulo}</h2>
            <p class="pj-modal__resumo">{p.data.resumo}</p>
            {p.data.stack.length > 0 && (
              <ul class="pj-chips" aria-label="Tecnologias">
                {p.data.stack.map((s) => <li>{s}</li>)}
              </ul>
            )}
            <div class="prose pj-prose"><Content /></div>
            {p.data.links.length > 0 && (
              <p class="pj-modal__links">
                {p.data.links.map((l, i) => <a class={`btn${i ? ' btn--light' : ''}`} href={l.url} target="_blank" rel="noopener">{l.rotulo} ↗</a>)}
              </p>
            )}
          </div>
        </div>
      </div>
    </dialog>
  ))}
</Base>

<style is:global>
  .eyebrow{font:600 13px/1 var(--font-body);letter-spacing:.12em;text-transform:uppercase;opacity:.8;margin:0 0 var(--s-3)}
  .btn--big{padding:15px 24px;font-size:16px}
  .pj-sec{padding-block:var(--s-6)}
  .pj-sec .t2{margin-bottom:var(--s-5)}
  .pj-lead{max-width:50ch;font-size:var(--t-22);line-height:1.35}
  .pj-cta{display:flex;flex-wrap:wrap;gap:var(--s-3);margin-top:var(--s-4)}
  .pj-cta--c{justify-content:center}

  /* abertura */
  .pj-hero{background:var(--cobalt);padding-top:96px;padding-bottom:var(--s-6);overflow:clip}
  .pj-hero__in{display:grid;grid-template-columns:1.25fr .75fr;gap:var(--s-5);align-items:center}
  .pj-h1{font:900 clamp(3.2rem,9.5vw,8.5rem)/.84 var(--font-display);font-stretch:68%;text-transform:uppercase;letter-spacing:-.01em;margin:0 0 var(--s-4)}
  .pj-h1 span,.pj-h1 em{display:block;white-space:nowrap}
  .pj-h1 em{font-style:italic;font-stretch:62%;color:var(--lime)}
  .pj-hero__art{position:relative;justify-self:center;width:min(320px,76%)}
  .pj-obj{width:100%;height:auto;rotate:5deg;animation:pj-in 1.6s var(--ease-spring) .2s backwards,pj-bob 4.2s ease-in-out 1.8s infinite alternate;will-change:transform}
  .pj-spark{position:absolute;left:-14%;top:-8%;width:28%;height:auto;animation:pj-in 1.6s var(--ease-spring) .6s backwards}
  @keyframes pj-in{from{transform:translateY(40px) scale(.3) rotate(-60deg);opacity:0}}
  @keyframes pj-bob{to{transform:translateY(-8px)}}

  /* cartões */
  .pj-grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--s-5) var(--s-4)}
  .pj-card--big{grid-column:1/-1}
  .pj-link{display:grid;height:100%;align-content:start;border:2px solid var(--ink);border-radius:var(--r-md);background:var(--white);color:var(--ink);box-shadow:var(--shadow-card);text-decoration:none;overflow:hidden;transition:transform .35s var(--ease-pop),box-shadow .35s var(--ease-pop)}
  .pj-link:hover{transform:translate(-4px,-4px);box-shadow:10px 10px 0 var(--ink)}
  .pj-link:active{transform:translate(3px,3px);box-shadow:2px 2px 0 var(--ink)}
  .pj-link:focus-visible{outline:3px solid var(--cobalt);outline-offset:5px}
  .pj-body{display:grid;gap:8px;padding:var(--s-4);align-content:start}
  .pj-ctx{font:700 12px/1.2 var(--font-body);letter-spacing:.05em;text-transform:uppercase;color:var(--cobalt)}
  .pj-t{font:900 italic clamp(1.9rem,3.2vw,2.5rem)/.92 var(--font-display);font-stretch:62%;text-transform:uppercase;color:var(--ink);text-wrap:balance}
  .pj-p{font-size:15.5px;line-height:1.45}
  .pj-stack{display:flex;flex-wrap:wrap;gap:6px;margin-top:4px}
  .pj-stack span{padding:5px 10px;border-radius:var(--r-pill);border:1.5px solid var(--ink);font:600 12px/1 var(--font-body);background:var(--mist)}
  .pj-go{margin-top:6px;font:700 14px/1 var(--font-body);color:var(--cobalt)}
  .pj-link:hover .pj-go{text-decoration:underline}
  /* destaque: capa de um lado, texto do outro */
  @media (min-width:821px){
    .pj-card--big .pj-link{grid-template-columns:1.15fr 1fr;align-content:stretch}
    .pj-card--big .capa{aspect-ratio:auto;min-height:320px;height:100%;border-bottom:0;border-right:2px solid var(--ink)}
    .pj-card--big .pj-body{padding:var(--s-5);align-content:center;gap:12px}
    .pj-card--big .pj-t{font-size:clamp(2.6rem,4.6vw,3.8rem)}
    .pj-card--big .pj-p{font-size:var(--t-17);max-width:44ch}
  }

  /* janela do projeto */
  html:has(.pj-modal[open]){overflow:hidden}
  .pj-modal{border:0;padding:0;background:transparent;max-width:none;max-height:none;margin:auto;overflow:visible}
  .pj-modal::backdrop{background:rgba(0,16,74,.82)}
  .pj-modal[open]{animation:pj-pop .5s var(--ease-spring)}
  @keyframes pj-pop{from{transform:translateY(40px) scale(.92);opacity:0}}
  .pj-modal__in{position:relative;width:min(760px,94vw);background:var(--white);color:var(--ink);border:2px solid var(--ink);border-radius:var(--r-lg);box-shadow:var(--shadow-card)}
  .pj-modal__scroll{max-height:min(88vh,88dvh);overflow-y:auto;overscroll-behavior:contain;border-radius:calc(var(--r-lg) - 2px);-webkit-overflow-scrolling:touch}
  .pj-modal__x{position:absolute;right:12px;top:12px;z-index:2;width:44px;height:44px;border-radius:50%;border:2px solid var(--ink);background:var(--lime);color:var(--ink);font:900 16px/1 var(--font-body);cursor:pointer;box-shadow:0 3px 0 var(--ink);transition:transform .3s var(--ease-pop)}
  .pj-modal__x:hover{transform:rotate(90deg) scale(1.08)}
  .pj-modal__x:focus-visible{outline:3px solid var(--cobalt);outline-offset:3px}
  .pj-modal__txt{padding:var(--s-4) var(--s-5) var(--s-5)}
  .pj-modal__meta{display:flex;flex-wrap:wrap;gap:var(--s-2) var(--s-3);align-items:center;margin:0 0 var(--s-3);font:600 13px/1.2 var(--font-body);color:var(--cobalt)}
  .pj-tag{background:var(--cobalt);color:var(--white);border-radius:var(--r-pill);padding:5px 11px;font:700 11px/1 var(--font-body);letter-spacing:.05em;text-transform:uppercase}
  .pj-modal__t{font:900 italic clamp(2.2rem,6vw,3.6rem)/.9 var(--font-display);font-stretch:62%;text-transform:uppercase;color:var(--cobalt);margin:0 0 var(--s-3);text-wrap:balance}
  .pj-modal__resumo{font-size:var(--t-22);line-height:1.35;margin:0 0 var(--s-4)}
  .pj-chips{list-style:none;margin:0 0 var(--s-4);padding:0;display:flex;flex-wrap:wrap;gap:var(--s-2)}
  .pj-chips li{padding:8px 14px;border-radius:var(--r-pill);border:2px solid var(--ink);background:var(--lime);font:700 13px/1 var(--font-body);box-shadow:0 2px 0 var(--ink)}
  .pj-chips li:nth-child(3n+2){background:var(--white)}.pj-chips li:nth-child(3n){background:var(--mist)}
  .pj-prose{font-size:17px;line-height:1.65;max-width:62ch}
  .pj-prose>*+*{margin-top:1em}
  .pj-prose h2{font:600 clamp(1.4rem,3vw,1.75rem)/1.15 var(--font-body);letter-spacing:-.03em;color:var(--cobalt);margin-top:1.6em}
  .pj-prose ul,.pj-prose ol{padding-left:1.3em}
  .pj-prose li+li{margin-top:.45em}
  .pj-prose strong{font-weight:700}
  .pj-prose code{background:var(--mist);padding:2px 6px;border-radius:6px;font-size:.9em}
  .pj-modal__links{display:flex;flex-wrap:wrap;gap:var(--s-3);margin:var(--s-5) 0 0}

  .pj-end{text-align:center}
  .pj-end .t2,.pj-end .pj-lead{margin-inline:auto}

  @media (max-width:1040px){.pj-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media (max-width:820px){
    .pj-hero__in{grid-template-columns:1fr}
    .pj-hero__art{order:-1;width:min(180px,48%);justify-self:start;margin-left:var(--s-4)}
    .pj-hero{padding-top:88px}
    .pj-sec{padding-block:var(--s-5)}
    .pj-grid{grid-template-columns:1fr;gap:var(--s-4)}
    .pj-modal__txt{padding:var(--s-4)}
    .pj-modal__resumo{font-size:var(--t-17)}
    .pj-prose{font-size:16px}
  }
  @media (prefers-reduced-motion:reduce){.pj-obj,.pj-spark{animation:none}.pj-modal[open]{animation:none}}
</style>

<script>
  import { initSmooth } from '../scripts/smooth';

  initSmooth();

  // Janela do projeto: abre no clique do cartão e também pelo endereço (/projetos#mini-rag), para dar um link direto.
  const janelas = [...document.querySelectorAll<HTMLDialogElement>('.pj-modal')];
  const porId = new Map(janelas.map((j) => [j.id, j]));
  const suporta = typeof HTMLDialogElement !== 'undefined' && typeof HTMLDialogElement.prototype.showModal === 'function';
  let origem: HTMLElement | null = null;

  const abrir = (id: string, de?: HTMLElement) => {
    const j = porId.get(id);
    if (!j || j.open || !suporta) return false;
    origem = de ?? null;
    j.showModal();
    j.querySelector<HTMLElement>('.pj-modal__scroll')!.scrollTop = 0;
    history.replaceState(null, '', `#${id}`);
    return true;
  };

  document.querySelectorAll<HTMLAnchorElement>('[data-proj]').forEach((a) => {
    a.addEventListener('click', (e) => {
      if (e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) return;
      if (abrir(a.dataset.proj!, a)) e.preventDefault();
    });
  });

  janelas.forEach((j) => {
    j.querySelector('[data-fechar]')!.addEventListener('click', () => j.close());
    j.addEventListener('click', (e) => { if (e.target === j) j.close(); });   // clique fora fecha
    j.addEventListener('close', () => {
      history.replaceState(null, '', location.pathname + location.search);
      origem?.focus({ preventScroll: true });
      origem = null;
    });
  });

  const peloEndereco = () => { const id = decodeURIComponent(location.hash.slice(1)); if (id) abrir(id); };
  peloEndereco();
  addEventListener('hashchange', peloEndereco);
</script>
