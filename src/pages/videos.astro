---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';

const perfil = 'https://www.instagram.com/devEduardo';

// Para cada vídeo novo: copie um bloco e troque `reel` pelo código do link (instagram.com/reel/CÓDIGO/).
// `capa` é o nome da imagem gerada por `python tools/capas.py` (9:16); sem ela aparece a capa tipográfica.
const videos = [
  { id: 'dia', reel: 'Db5dnQdMR2S', tema: 'Rotina', cor: 'l', t: 'Meu dia', p: 'Um daily vlog: um dia da minha rotina, do começo ao fim.', capa: 'capa-dia' },
  { id: 'deep-research', reel: 'DeKz-9lMY6B', tema: 'Ferramentas de IA', cor: 'w', t: 'Valide seu app com IA', p: 'Ensino a usar o Deep Research do Google para validar a ideia de um aplicativo: ver se é possível, analisar o cenário e receber um relatório sobre como ele pode se comportar no mercado e se vale a pena.', capa: 'capa-deep-research' },
  { id: 'navier-stokes', reel: 'DdKOUZvsTXl', tema: 'Notícias de IA', cor: 'm', t: 'OpenAI e Navier-Stokes', p: 'Falo sobre o caso envolvendo a OpenAI e a equação de Navier-Stokes.', capa: 'capa-navier-stokes' },
];
const temas = [...new Set(videos.map((v) => v.tema))];
---
<Base
  title="Vídeos de IA para iniciantes no Instagram | Eduardo Rivabem"
  description="Vídeos do @DevEduardo: inteligência artificial para iniciantes e curiosos, como usar o Google Deep Research, rotina de faculdade e notícias de IA."
  preload={{ name: 'obj-videos', sizes: '(max-width:820px) 40vw, 240px' }}
>
  <!-- ABERTURA -->
  <section class="vd-hero">
    <div class="vd-hero__in wrap">
      <div>
        <p class="eyebrow">Vídeos</p>
        <h1 class="vd-h1"><span>IA para</span> <em>iniciantes</em></h1>
        <p class="vd-lead">No Instagram, o @DevEduardo explica inteligência artificial para iniciantes e curiosos, com um pouco de humor e de vida na faculdade.</p>
        <p class="vd-cta">
          <a class="btn btn--big" href={perfil} target="_blank" rel="noopener">Seguir @DevEduardo</a>
          <a class="btn btn--light btn--big" href="#lista">Ver os vídeos</a>
        </p>
      </div>
      <div class="vd-hero__art" aria-hidden="true">
        <Pic class="vd-phone" name="obj-videos" sizes="(max-width:820px) 40vw, 240px" fetchpriority="high" />
        <Pic class="vd-spark vd-spark--a" name="ico-estrela" sizes="80px" />
        <Pic class="vd-spark vd-spark--b" name="ico-carinha" sizes="80px" />
      </div>
    </div>
  </section>

  <!-- VÍDEOS -->
  <section class="frame frame--inv vd-sec" id="lista">
    <div class="wrap">
      <h2 class="t2">Os vídeos<em>mais recentes</em></h2>

      <div class="vd-filtro" role="group" aria-label="Filtrar por tema">
        <button type="button" class="chip is-on" data-tema="" aria-pressed="true">Todos</button>
        {temas.map((t) => <button type="button" class="chip" data-tema={t} aria-pressed="false">{t}</button>)}
      </div>

      <ul class="vd-grid" id="vdGrid">
        {videos.map((v, i) => (
          <li class={`vd-card vd-card--${v.cor}`} data-tema={v.tema}>
            <a class="vd-link" href={`https://www.instagram.com/reel/${v.reel}/`} target="_blank" rel="noopener" data-reel={v.reel} data-t={v.t} data-p={v.p} aria-label={`${v.t}: assistir`}>
              <span class="vd-cover">
                {v.capa
                  ? <Pic name={v.capa} sizes="(max-width:820px) 45vw, 300px" loading="lazy" />
                  : <>
                      <span class="vd-cover__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                      <span class="vd-cover__t" aria-hidden="true">{v.t}</span>
                    </>}
                <span class="vd-play" aria-hidden="true"></span>
              </span>
              <span class="vd-body">
                <span class="vd-tag">{v.tema}</span>
                <span class="vd-t">{v.t}</span>
                <span class="vd-p">{v.p}</span>
                <span class="vd-go">Assistir ▶</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="vd-note" id="vdVazio" hidden>Nenhum vídeo nesse tema ainda.</p>
    </div>
  </section>

  <!-- FECHO -->
  <section class="frame vd-sec vd-end">
    <div class="wrap">
      <h2 class="t2">Quer aprender IA<em>sem complicação?</em></h2>
      <p class="vd-lead">Vídeos curtos, em português, com exemplos que você consegue repetir. Novos vídeos no Instagram.</p>
      <p class="vd-cta vd-cta--c">
        <a class="btn btn--big" href={perfil} target="_blank" rel="noopener">Seguir @DevEduardo no Instagram</a>
      </p>
    </div>
  </section>

  <dialog class="vd-player" id="player" aria-labelledby="playerT">
    <div class="vd-player__in">
      <button class="vd-player__x" type="button" id="playerX" aria-label="Fechar">✕</button>
      <p class="vd-player__t" id="playerT"></p>
      <div class="vd-player__frame" id="playerFrame"></div>
      <p class="vd-player__foot"><a id="playerLink" href={perfil} target="_blank" rel="noopener">Abrir no Instagram ↗</a><span>O vídeo carrega do Instagram só quando você aperta para assistir.</span></p>
    </div>
  </dialog>
</Base>

<style is:global>
  .eyebrow{font:600 13px/1 var(--font-body);letter-spacing:.12em;text-transform:uppercase;opacity:.8;margin:0 0 var(--s-3)}
  .btn--big{padding:15px 24px;font-size:16px}
  .vd-sec{padding-block:var(--s-6)}
  .vd-sec .t2{margin-bottom:var(--s-4)}
  .vd-lead{max-width:48ch;font-size:var(--t-22);line-height:1.35}
  .vd-cta{display:flex;flex-wrap:wrap;gap:var(--s-3);margin-top:var(--s-4)}

  /* abertura */
  .vd-hero{background:var(--cobalt);padding-top:96px;padding-bottom:var(--s-6);overflow:clip}
  .vd-hero__in{display:grid;grid-template-columns:1.3fr .7fr;gap:var(--s-5);align-items:center}
  .vd-h1{font:900 clamp(3.4rem,10vw,9rem)/.84 var(--font-display);font-stretch:68%;text-transform:uppercase;letter-spacing:-.01em;margin:0 0 var(--s-4)}
  .vd-h1 span,.vd-h1 em{display:block;white-space:nowrap}
  .vd-h1 em{font-style:italic;font-stretch:62%;color:var(--lime)}
  .vd-hero__art{position:relative;justify-self:center;width:min(240px,60%)}
  .vd-phone{width:100%;height:auto;rotate:-6deg;animation:vd-in 1.6s var(--ease-spring) .2s backwards,vd-bob 4.2s ease-in-out 1.8s infinite alternate;will-change:transform}
  .vd-spark{position:absolute;height:auto;animation:vd-in 1.6s var(--ease-spring) backwards}
  .vd-spark--a{width:34%;left:-26%;top:8%;animation-delay:.5s}
  .vd-spark--b{width:30%;right:-22%;bottom:10%;animation-delay:.7s}
  @keyframes vd-in{from{transform:translateY(40px) scale(.3) rotate(-60deg);opacity:0}}
  @keyframes vd-bob{to{transform:translateY(-8px)}}

  /* filtro */
  .vd-filtro{display:flex;flex-wrap:wrap;gap:var(--s-2);margin-bottom:var(--s-5)}
  .chip{padding:10px 18px;border-radius:var(--r-pill);border:2px solid var(--ink);background:var(--white);color:var(--ink);font:600 15px/1 var(--font-body);cursor:pointer;box-shadow:0 3px 0 var(--ink);transition:transform .4s var(--ease-spring),box-shadow .4s var(--ease-spring),background .2s}
  .chip:hover{transform:translateY(-2px);box-shadow:0 5px 0 var(--ink)}
  .chip:active{transform:translateY(2px);box-shadow:0 1px 0 var(--ink)}
  .chip.is-on{background:var(--lime)}
  .chip:focus-visible{outline:3px solid var(--cobalt);outline-offset:3px}

  /* grade de vídeos */
  .vd-grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,240px),300px));justify-content:start;gap:var(--s-5) var(--s-4)}
  .vd-card[hidden]{display:none}
  .vd-link{display:grid;gap:var(--s-3);text-decoration:none;color:var(--ink)}
  .vd-cover{position:relative;display:flex;flex-direction:column;justify-content:space-between;aspect-ratio:9/16;border:2px solid var(--ink);border-radius:var(--r-md);box-shadow:var(--shadow-card);overflow:hidden;padding:var(--s-4);transition:transform .35s var(--ease-pop),box-shadow .35s var(--ease-pop)}
  .vd-cover img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .vd-card--l .vd-cover{background:var(--lime)}
  .vd-card--w .vd-cover{background:var(--white)}
  .vd-card--m .vd-cover{background:var(--mist)}
  .vd-cover__n{font:900 clamp(3.5rem,9vw,5.5rem)/.8 var(--font-display);font-stretch:62%;color:var(--cobalt)}
  .vd-cover__t{font:900 italic clamp(1.9rem,4.2vw,2.8rem)/.92 var(--font-display);font-stretch:62%;text-transform:uppercase;color:var(--ink);text-wrap:balance}
  .vd-play{position:absolute;right:var(--s-3);top:var(--s-3);width:56px;height:56px;border-radius:50%;background:var(--ink);transition:transform .35s var(--ease-pop)}
  .vd-play::after{content:"";position:absolute;left:23px;top:16px;border-left:18px solid var(--lime);border-top:12px solid transparent;border-bottom:12px solid transparent}
  .vd-link:hover .vd-cover{transform:translate(-4px,-4px) rotate(-1.5deg);box-shadow:10px 10px 0 var(--ink)}
  .vd-link:hover .vd-play{transform:scale(1.15) rotate(8deg)}
  .vd-link:active .vd-cover{transform:translate(3px,3px);box-shadow:2px 2px 0 var(--ink)}
  .vd-link:focus-visible{outline:3px solid var(--cobalt);outline-offset:6px;border-radius:var(--r-md)}
  .vd-body{display:grid;gap:6px}
  .vd-tag{justify-self:start;background:var(--cobalt);color:var(--white);border-radius:var(--r-pill);padding:4px 10px;font:700 11px/1 var(--font-body);letter-spacing:.05em;text-transform:uppercase}
  .vd-t{font:600 var(--t-22)/1.1 var(--font-body);letter-spacing:-.02em;color:var(--cobalt)}
  .vd-p{font-size:15px;line-height:1.45}
  .vd-go{font:700 14px/1 var(--font-body);color:var(--cobalt);margin-top:4px}
  .vd-link:hover .vd-go{text-decoration:underline}
  .vd-note{margin:var(--s-4) 0 0;color:var(--ink)}

  /* player: o Instagram só carrega quando a pessoa abre */
  .vd-player{border:0;padding:0;background:transparent;max-width:none;max-height:none;margin:auto;overflow:visible}
  .vd-player::backdrop{background:rgba(0,16,74,.82)}
  .vd-player[open]{animation:pl-in .5s var(--ease-spring)}
  @keyframes pl-in{from{transform:translateY(40px) scale(.9);opacity:0}}
  .vd-player__in{position:relative;width:min(440px,92vw);background:var(--white);color:var(--ink);border:2px solid var(--ink);border-radius:var(--r-lg);box-shadow:var(--shadow-card);padding:var(--s-4);display:grid;gap:var(--s-3)}
  .vd-player__x{position:absolute;right:12px;top:12px;width:40px;height:40px;border-radius:50%;border:2px solid var(--ink);background:var(--lime);color:var(--ink);font:900 16px/1 var(--font-body);cursor:pointer;box-shadow:0 3px 0 var(--ink);z-index:2}
  .vd-player__t{font:900 italic 1.5rem/.95 var(--font-display);font-stretch:62%;text-transform:uppercase;color:var(--cobalt);padding-right:52px;margin:0}
  .vd-player__frame{height:min(72vh,680px);border-radius:var(--r-md);overflow:hidden;background:var(--mist)}
  .vd-player__frame iframe{width:100%;height:100%;border:0;display:block}
  .vd-player__foot{display:grid;gap:4px;margin:0;font-size:13px}
  .vd-player__foot a{font-weight:700;color:var(--cobalt)}
  .vd-player__foot span{opacity:.7}
  @media (prefers-reduced-motion:reduce){.vd-player[open]{animation:none}}

  .vd-end{text-align:center}
  .vd-end .t2,.vd-end .vd-lead{margin-inline:auto}
  .vd-cta--c{justify-content:center}

  @media (max-width:820px){
    .vd-hero__in{grid-template-columns:1fr}
    .vd-hero__art{order:-1;width:min(150px,40%);justify-self:start;margin-left:var(--s-4)}
    .vd-hero{padding-top:88px}
    .vd-sec{padding-block:var(--s-5)}
    .vd-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--s-4) var(--s-3)}
    .vd-cover{padding:var(--s-3);box-shadow:4px 4px 0 var(--ink)}
    .vd-cover__n{font-size:2.8rem}
    .vd-cover__t{font-size:1.4rem}
    .vd-play{width:40px;height:40px;right:10px;top:10px}
    .vd-play::after{left:16px;top:11px;border-left-width:13px;border-top-width:9px;border-bottom-width:9px}
    .vd-t{font-size:1.1rem}
    .vd-p{font-size:13.5px}
  }
  @media (prefers-reduced-motion:reduce){.vd-phone,.vd-spark{animation:none}}
</style>

<script>
  import { initSmooth } from '../scripts/smooth';

  initSmooth();

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const grid = document.getElementById('vdGrid') as HTMLElement;
  const cards = [...grid.querySelectorAll<HTMLElement>('.vd-card')];
  const SPRING = 'linear(0,0.5737 7.6%,0.8382 11.87%,0.9463 14.19%,1.0292 16.54%,1.0886 18.97%,1.1258 21.53%,1.137 22.97%,1.1424 24.48%,1.1423 26.1%,1.1366 27.86%,1.1165 31.01%,1.0507 38.62%,1.0219 42.57%,0.9995 46.99%,0.9872 51.63%,0.9842 58.77%,1.0011 81.26%,1)';

  // As capas chegam empilhadas em leque e se abrem em grade, em mola, quando a seção entra na tela.
  const abrir = () => {
    const g = grid.getBoundingClientRect();
    const cx = g.left + g.width / 2, cy = g.top + Math.min(g.height, innerHeight) / 2;
    const n = cards.length;
    cards.forEach((c, i) => {
      const r = c.getBoundingClientRect();
      const meio = i - (n - 1) / 2;
      const dx = cx - (r.left + r.width / 2) + meio * 38;
      const dy = cy - (r.top + r.height / 2) + Math.abs(meio) * 10;
      const fan = { translate: `${dx}px ${dy}px`, rotate: `${meio * 14}deg`, scale: 0.85, opacity: 1 };
      c.style.opacity = '';
      c.animate(
        [{ ...fan, offset: 0 }, { ...fan, offset: 0.28 }, { translate: '0px 0px', rotate: '0deg', scale: 1, opacity: 1, offset: 1 }],
        { duration: 1400, delay: i * 60, easing: SPRING, fill: 'backwards' },
      );
    });
  };

  if (!reduce && cards.length) {
    cards.forEach((c) => (c.style.opacity = '0'));
    const io = new IntersectionObserver((es) => {
      if (!es[0].isIntersecting) return;
      io.disconnect();
      abrir();
    }, { threshold: 0.25 });
    io.observe(grid);
    // segurança: se o observador não disparar, não deixa as capas invisíveis
    setTimeout(() => cards.forEach((c) => { if (c.style.opacity === '0') c.style.opacity = ''; }), 6000);
  }

  // Player: abre um diálogo e só então carrega o vídeo do Instagram (nada de terceiros ao abrir a página).
  const player = document.getElementById('player') as HTMLDialogElement;
  const frame = document.getElementById('playerFrame') as HTMLElement;
  const pTitulo = document.getElementById('playerT') as HTMLElement;
  const pLink = document.getElementById('playerLink') as HTMLAnchorElement;
  let preconectou = false;
  const preconectar = () => {
    if (preconectou) return;
    preconectou = true;
    const l = document.createElement('link'); l.rel = 'preconnect'; l.href = 'https://www.instagram.com'; document.head.appendChild(l);
  };
  cards.forEach((c) => {
    const a = c.querySelector<HTMLAnchorElement>('.vd-link')!;
    a.addEventListener('pointerenter', preconectar, { once: true });
    a.addEventListener('focus', preconectar, { once: true });
    a.addEventListener('touchstart', preconectar, { once: true, passive: true });
    a.addEventListener('click', (e) => {
      if (e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0 || typeof player.showModal !== 'function') return;   // deixa abrir em outra aba
      e.preventDefault();
      const reel = a.dataset.reel!;
      pTitulo.textContent = a.dataset.t ?? '';
      pLink.href = a.href;
      const f = document.createElement('iframe');
      f.src = `https://www.instagram.com/reel/${reel}/embed/`;
      f.title = `Vídeo: ${a.dataset.t}`;
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      f.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.replaceChildren(f);
      player.showModal();
    });
  });
  const fechar = () => { player.close(); };
  document.getElementById('playerX')!.addEventListener('click', fechar);
  player.addEventListener('click', (e) => { if (e.target === player) fechar(); });   // clique fora fecha
  player.addEventListener('close', () => frame.replaceChildren());                  // descarrega o vídeo (para o som)

  // Filtro por tema
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
  const vazio = document.getElementById('vdVazio') as HTMLElement;
  chips.forEach((chip) => chip.addEventListener('click', () => {
    const tema = chip.dataset.tema ?? '';
    chips.forEach((c) => { const on = c === chip; c.classList.toggle('is-on', on); c.setAttribute('aria-pressed', String(on)); });
    let visiveis = 0;
    cards.forEach((c) => {
      const mostrar = !tema || c.dataset.tema === tema;
      const estava = !c.hidden;
      c.hidden = !mostrar;
      if (mostrar) {
        visiveis++;
        c.style.opacity = '';
        if (!estava && !reduce) c.animate([{ scale: 0.85, opacity: 0 }, { scale: 1, opacity: 1 }], { duration: 700, easing: SPRING });
      }
    });
    vazio.hidden = visiveis > 0;
  }));
</script>
